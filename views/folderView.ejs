<html>

  <head>
      <title>Folder</title>
      <link type="text/css" href="/css/styles.css" rel="stylesheet">
  </head>

  <body>

    <div class="container">

      <h2>Folder</h2>

      <p>
        <a  href="/folder/<%=folderId%>/update">Update folder</a>
      </p>

      <p>
        foldername: <%=folder.foldername%> (id: <%=folder.id%>)
      </p>

      <h4>Files</h4>

          <a  href="/upload?folder=<%=folder.id%>">Upload file</a>

          <% files.forEach(file => { %>

          <p>
            filename: <a  href="/folder/<%=folder.id%>/file/<%=file.id%>"><%=file.filename%></a> (id: <%=file.id%>)
          </p>

      <% }); %>

      <a href="/">Back to home</a>

    </div>
    
  </body>

</html>