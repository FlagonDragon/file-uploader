<html>

  <head>
      <title>My App</title>
      <link type="text/css" href="/css/styles.css" rel="stylesheet">
  </head>

  <body>

    <div class="container">

      <h2>Homepage</h2>

      <h4>Users</h4>

      <% users.forEach(user => { %>

          <p>
            username: <%=user.username%> (id: <%=user.id%>)
          </p>

        </a>

      <% }); %>

      <h4>Folders</h4>

      <% folders.forEach(folder => { %>

          <p>
            foldername: <%=folder.foldername%> (id: <%=folder.id%>)
          </p>

        </a>

      <% }); %>

    </div>
    
  </body>

</html>