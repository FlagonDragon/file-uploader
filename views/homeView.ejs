<html>

  <head>
      <title>Homepage</title>
      <link type="text/css" href="/css/styles.css" rel="stylesheet">
  </head>

  <body>

    <div class="container">

      <h2>Homepage</h2>

      <% if (locals.user) {%>

        <h4>Welcome, <%=locals.user.username%></h4>

      <% } %>
  
      <h4>Folders</h4>

      <a  href="/add-folder/">Add folder</a>

      <% folders.forEach(folder => { %>

          <p>
            foldername: <a  href="/folder/<%=folder.id%>"><%=folder.foldername%></a> (id: <%=folder.id%>)
          </p>

      <% }); %>

    </div>
    
  </body>

</html>