<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
  <link type="text/css" href="/css/styles.css" rel="stylesheet">
</head>
<body>
  
  <h1>Upload</h1>

  <%- include("partials/errors.ejs") %>

  <% if (locals.user) {%>

  <form action="/upload" method="POST" enctype="multipart/form-data">
    <label for="myfile">Select a file:</label>
    <input type="file" id="myfile" name="myfile">
    <label for="filename">File Name:</label>
    <input id="filename" name="filename" placeholder="File Name" type="text" />
    <input id="folderId" name="folderId" value="<%=folderId%>" type="hidden" />
    <button type="submit">Upload</button>
  </form>

  <% } else {%>

  <h3>Must be logged in to upload</h3> 
  <a href="/log-in/?from=upload&folder=<%=folderId%>">Log in</a>
  <a href="/sign-up/?from=upload&folder=<%=folderId%>">Sign up</a>

  <% } %>

  
</body>
</html>